# TBS WebUI — configuración de ejemplo.
#
# Copiar a `.env` junto a `app/` y ajustar. NINGÚN valor de ejemplo es una
# credencial real: el asistente del primer arranque o TBS_ADMIN_PASSWORD
# definen la contraseña del administrador.
#
# Todas las variables son opcionales; los valores mostrados son los defectos.

# --- Red ---------------------------------------------------------------
TBS_HOST=0.0.0.0
TBS_PORT=9000
# TBS_ROOT_PATH=/tbs            # si se publica detrás de un subpath en Nginx

# --- Datos -------------------------------------------------------------
# TBS_DATA_DIR=/var/lib/tbs-webui      # base de datos, secret.key y logs
# TBS_DATABASE_URL=sqlite:////var/lib/tbs-webui/tbs-webui.db
#   También admite PostgreSQL/similar: postgresql+psycopg://usuario:clave@host/db

# --- Seguridad ---------------------------------------------------------
# Clave de firma de sesiones. Si se omite se genera en <DATA_DIR>/secret.key
# con permisos 0600. Definirla sólo si se despliegan varias instancias.
# TBS_SESSION_SECRET=cambia-esto-por-un-valor-aleatorio-largo
TBS_SESSION_COOKIE=tbs_session
TBS_CSRF_COOKIE=tbs_csrf
TBS_SESSION_MAX_AGE=43200
# Poner a 1 cuando se publique por HTTPS (cookies Secure)
TBS_SECURE_COOKIES=0

# --- Primer arranque ---------------------------------------------------
# Usuario administrador inicial. La contraseña se puede definir aquí (se
# recomienda borrarla después del primer arranque) o dejarse vacía para crear
# el admin desde el asistente web (/login) o con contraseña aleatoria en el log.
TBS_ADMIN_USER=admin
# TBS_ADMIN_PASSWORD=
# TBS_ALLOW_SETUP=1

# --- Límite de intentos de login ---------------------------------------
TBS_LOGIN_MAX_ATTEMPTS=5
TBS_LOGIN_WINDOW_SECONDS=300
TBS_LOGIN_LOCK_SECONDS=300

# --- DVB ---------------------------------------------------------------
# 1 = simulación (desarrollo sin tarjeta). También se activa solo si no existe
# /dev/dvb en el sistema.
TBS_MOCK=0
TBS_DEFAULT_ADAPTER=0
TBS_DEFAULT_FRONTEND=0
TBS_SCAN_TABLES_DIR=/usr/share/dvb
TBS_DVBV5_SCAN_BIN=dvbv5-scan
TBS_DVBV5_ZAP_BIN=dvbv5-zap
TBS_DVB_FE_TOOL_BIN=dvb-fe-tool
TBS_DEVICE_LOCK_TIMEOUT=120

# --- Interfaz ----------------------------------------------------------
TBS_SIGNAL_POLL_MS=500
TBS_HISTORY_SECONDS=60
TBS_LOCK_TIMEOUT_S=5

# --- LNB universal por defecto -----------------------------------------
TBS_LNB_LOW_KHZ=9750
TBS_LNB_HIGH_KHZ=10600
TBS_LNB_THRESHOLD_KHZ=11700

# --- Logs --------------------------------------------------------------
TBS_LOG_LEVEL=INFO

# --- Newcamd (card sharing propio o autorizado) ------------------------
# Usa SOLO servidores de tu propiedad o para los que tengas autorizacion.
TBS_NEWCAMD_ENABLED=1
TBS_NEWCAMD_TIMEOUT_S=8
# Conectar al arrancar las cuentas marcadas como "auto_connect"
TBS_NEWCAMD_AUTO_CONNECT=0

# --- Transponder favorito (boton de sintonizacion rapida) --------------
TBS_FAVOURITE_ADAPTER=0
TBS_FAVOURITE_FREQUENCY_KHZ=10970000
TBS_FAVOURITE_SYMBOL_RATE_KSPS=27900
TBS_FAVOURITE_POLARIZATION=V
