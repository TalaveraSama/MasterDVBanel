# TBS WebUI — variables de entorno para el servicio systemd (EnvironmentFile).
#
# Destino recomendado: /etc/tbs-webui/tbs-webui.env   (permisos 0600)
# La unidad lo carga con:  EnvironmentFile=-/etc/tbs-webui/tbs-webui.env
#
# Formato de systemd:  CLAVE=valor  (una por línea, sin `export`, sin comillas
# innecesarias). Las líneas que empiezan por # o ; se ignoran.
#
# PREFERENCIA: el entorno definido aquí GANA sobre el fichero
# <proyecto>/.env. Si editas un valor, hazlo en este fichero y reinicia:
#     sudo systemctl restart tbs-webui
#
# NUNCA guardes credenciales reales en el repositorio: este fichero es una
# plantilla sin secretos.

# --- Red ---------------------------------------------------------------------
# 0.0.0.0 escucha en todas las interfaces (LAN). Usa 127.0.0.1 si publicas el
# panel detrás de Nginx en la misma máquina.
TBS_HOST=0.0.0.0
TBS_PORT=9000

# --- Datos -------------------------------------------------------------------
# Base de datos SQLite, secret.key y logs. Debe coincidir con ReadWritePaths
# de la unidad (install.sh lo sustituye automáticamente).
TBS_DATA_DIR=/var/lib/tbs-webui
# TBS_DATABASE_URL=sqlite:////var/lib/tbs-webui/tbs-webui.db

# --- Seguridad ---------------------------------------------------------------
# Genera la clave de firma de sesiones con:   openssl rand -hex 32
# Si no se define, la aplicación la crea en <TBS_DATA_DIR>/secret.key (0600).
# TBS_SESSION_SECRET=
# Ponlo a 1 cuando el panel se publique por HTTPS (cookies Secure).
TBS_SECURE_COOKIES=0
TBS_LOGIN_MAX_ATTEMPTS=5
TBS_LOGIN_WINDOW_SECONDS=300
TBS_LOGIN_LOCK_SECONDS=300

# --- Primer arranque ---------------------------------------------------------
# Si NO hay usuarios y TBS_ADMIN_PASSWORD está vacía, el panel NO crea ninguno:
# el primer acceso a http://IP:9000/login muestra el asistente para crear el
# administrador (recomendado: la contraseña no queda en el entorno ni en el log).
# Si prefieres un despliegue desatendido, define la contraseña aquí para el
# primer arranque y BÓRRALA después de crear la cuenta.
TBS_ADMIN_USER=admin
# TBS_ADMIN_PASSWORD=
# TBS_ALLOW_SETUP=1

# --- Proxy inverso -----------------------------------------------------------
# Ponlo a 1 SOLO si el panel está detrás de un Nginx de confianza: la IP del
# cliente se tomará de X-Forwarded-For (auditoría y límite de intentos).
# TBS_TRUST_PROXY_HEADERS=0
# Subruta pública (Nginx sirviendo /tbs/ -> :9000/); vacío si no aplica.
# TBS_ROOT_PATH=

# --- DVB ---------------------------------------------------------------------
# 1 = modo simulación (sin tarjeta). Si no existe /dev/dvb se activa solo.
TBS_MOCK=0
TBS_DEFAULT_ADAPTER=0
TBS_DEFAULT_FRONTEND=0
TBS_SCAN_TABLES_DIR=/usr/share/dvb
TBS_DEVICE_LOCK_TIMEOUT=120

# --- Interfaz ----------------------------------------------------------------
TBS_SIGNAL_POLL_MS=500
TBS_HISTORY_SECONDS=60
TBS_LOCK_TIMEOUT_S=5

# --- Logs --------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
TBS_LOG_LEVEL=INFO

# --- Newcamd (card sharing propio o autorizado) -------------------------------
# Usa SOLO servidores de tu propiedad o para los que tengas autorizacion.
TBS_NEWCAMD_ENABLED=1
TBS_NEWCAMD_TIMEOUT_S=8
TBS_NEWCAMD_AUTO_CONNECT=0

# --- Proxy inverso ------------------------------------------------------------
# 1 solo detras de un Nginx de confianza (toma la IP de X-Forwarded-For).
# TBS_TRUST_PROXY_HEADERS=0
# TBS_ROOT_PATH=
